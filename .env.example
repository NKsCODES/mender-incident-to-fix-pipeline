MENDER_RUNNER=replay            # replay | cursor
CURSOR_API_KEY=                 # required for MENDER_RUNNER=cursor
MENDER_CURSOR_BIN=agent
MENDER_CURSOR_MODEL=
MENDER_WEBHOOK_SECRET=          # when set, POST /api/incidents needs X-Mender-Signature: sha256=<hmac of body>
MENDER_PRICE_IN=0               # USD per million input tokens; 0 reports cost as unknown
MENDER_PRICE_OUT=0
MENDER_MAX_ATTEMPTS=2
MENDER_AGENT_TIMEOUT_S=600
MENDER_PUBLISH=0                # 1 pushes the branch and opens a GitHub PR with gh
